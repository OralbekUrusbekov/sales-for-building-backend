# ─── Postgres ───────────────────────────────────────────────
POSTGRES_USER=remonthub
POSTGRES_PASSWORD=remonthub
POSTGRES_DB=remonthub
POSTGRES_PORT=5433          # host port -> container 5432

# ─── Redis ──────────────────────────────────────────────────
REDIS_PORT=6380             # host port -> container 6379

# ─── API ────────────────────────────────────────────────────
API_PORT=8000
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me-please-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
SEED_ON_START=true
CORS_ORIGINS=http://localhost:3030,http://localhost:3000

# Bootstrap admin (created by the seed script)
ADMIN_EMAIL=admin@remonthub.kz
ADMIN_PASSWORD=admin12345

# ─── Uploads ────────────────────────────────────────────────
# Origin used to build absolute URLs for files uploaded from the admin panel
# (no trailing slash, no /api). Change to the public site origin in prod.
PUBLIC_BASE_URL=http://localhost:8000

# ─── Frontend (Next.js, built from ../service-for-building-home) ────────────
FRONTEND_PORT=3040
# Baked into the client bundle at build time — the public URL of the API:
FRONTEND_API_URL=http://localhost:8000/api
# Set to e.g. /building when nginx serves the site from a sub-path; leave
# empty for a domain-root deployment.
FRONTEND_BASE_PATH=

# ─── Telegram bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
API_BASE_URL=http://api:8000

# Connection strings are injected by docker-compose. For running the API
# outside Docker, uncomment and point at the published host ports:
# DATABASE_URL=postgresql+asyncpg://remonthub:remonthub@localhost:5433/remonthub
# REDIS_URL=redis://localhost:6380/0
